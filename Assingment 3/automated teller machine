#include <stdio.h>
#include <stdbool.h>

#define CORRECT_PIN 1234
#define MAX_ATTEMPTS 3

// Global or shared variables for the account state
float balance = 1000.00; // Initial default balance

// Function prototypes
bool acceptTermsAndConditions();
bool login();
void showMenu();
void checkBalance();
void deposit(float amount);
void withdraw(float amount);

int main() {
    // New Feature: Terms and Conditions Check
    if (!acceptTermsAndConditions()) {
        printf("\nYou must accept the Terms and Conditions to use this ATM. Exiting...\n");
        return 0;
    }

    // Requirement 1: Login / PIN Verification
    if (!login()) {
        printf("\nMaximum attempts exceeded. Access denied. Exiting...\n");
        return 0;
    }

    int choice;
    
    // Requirement 4: Repeat Until Exit
    do {
        showMenu();
        printf("Enter your choice (1-4): ");
        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Please enter a number.\n");
            // Clear input buffer
            while (getchar() != '\n');
            continue;
        }

        // Requirement 3: Handle User Choice
        switch (choice) {
            case 1:
                checkBalance();
                break;
            case 2: {
                float depAmount;
                printf("Enter amount to deposit: $");
                scanf("%f", &depAmount);
                deposit(depAmount);
                break;
            }
            case 3: {
                float witAmount;
                printf("Enter amount to withdraw: $");
                scanf("%f", &witAmount);
                withdraw(witAmount);
                break;
            }
            case 4:
                printf("\nThank you for using our ATM. Goodbye!\n");
                break;
            default:
                printf("\nInvalid choice! Please select an option between 1 and 4.\n");
        }
        
        if (choice != 4) {
            printf("\n----------------------------------------\n");
        }

    } while (choice != 4);

    return 0;
}

// Terms and Conditions Function
bool acceptTermsAndConditions() {
    char choice;
    
    printf("\n========================================\n");
    printf("       ATM TERMS AND CONDITIONS         \n");
    printf("========================================\n");
    printf("1. You are responsible for keeping your PIN secure.\n");
    printf("2. All deposits and withdrawals are subject to bank verification.\n");
    printf("3. The bank is not liable for losses due to user negligence.\n");
    printf("4. Transactions must maintain valid positive balances where applicable.\n");
    printf("========================================\n");
    
    printf("Do you accept these terms and conditions? (y/n): ");
    scanf(" %c", &choice); // Space before %c skips any leftover whitespace/newline characters

    if (choice == 'y' || choice == 'Y') {
        printf("\nTerms accepted successfully.\n");
        return true;
    }
    
    return false;
}

// 1. Login Function
bool login() {
    int enteredPin;
    int attempts = 0;

    while (attempts < MAX_ATTEMPTS) {
        printf("\nEnter your 4-digit PIN: ");
        scanf("%d", &enteredPin);

        if (enteredPin == CORRECT_PIN) {
            printf("\nLogin Successful!\n");
            return true;
        } else {
            attempts++;
            printf("Incorrect PIN. You have %d attempt(s) remaining.\n", MAX_ATTEMPTS - attempts);
        }
    }
    return false;
}

// 2. Show ATM Menu
void showMenu() {
    printf("\n=== ATM Menu ===\n");
    printf("1. Balance Inquiry\n");
    printf("2. Deposit\n");
    printf("3. Withdraw\n");
    printf("4. Exit\n");
}

// 3. Balance Inquiry Function
void checkBalance() {
    printf("\n--- Balance Inquiry ---\n");
    printf("Current Account Balance: $%.2f\n", balance);
}

// Deposit Function (with Requirement 5 validation)
void deposit(float amount) {
    // Requirement 5.1: Positive number validation
    if (amount <= 0) {
        printf("\n[Error] Deposit amount must be a positive number.\n");
        return;
    }

    balance += amount;
    printf("\nSuccessfully deposited $%.2f\n", amount);
    checkBalance();
}

// Withdraw Function (with Requirement 5 validation)
void withdraw(float amount) {
    // Requirement 5.1: Positive number validation
    if (amount <= 0) {
        printf("\n[Error] Withdrawal amount must be a positive number.\n");
        return;
    }

    // Requirement 5.2: Ensure withdrawal does not exceed current balance
    if (amount > balance) {
        printf("\n[Error] Insufficient funds! Transaction failed.\n");
        checkBalance();
        return;
    }

    balance -= amount;
    printf("\nSuccessfully withdrew $%.2f\n", amount);
    checkBalance();
}
